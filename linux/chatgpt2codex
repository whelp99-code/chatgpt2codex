#!/usr/bin/env bash
set -Eeuo pipefail

resolve_self() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

ROOT="$(resolve_self)"

# Prefer the bundled runtime when the packaged .run shipped one, and fall back
# to the system Node otherwise. Exec'ing "$ROOT/bin/node" unconditionally broke
# every install that relies on the distribution's own Node, such as a source
# checkout or the Ubuntu installer.
if [ -x "$ROOT/bin/node" ]; then
  NODE="$ROOT/bin/node"
  export PATH="$ROOT/bin:$PATH"
elif command -v node >/dev/null 2>&1; then
  NODE="$(command -v node)"
else
  echo "chatgpt2codex: node not found. Install it with: sudo apt-get install -y nodejs" >&2
  exit 1
fi

exec "$NODE" "$ROOT/dist/cli.js" "$@"
